# Only NEXT_PUBLIC_* values here - they are shipped to the browser. Never put secrets in this file.
# Backend base URL (same-site with the frontend in production, e.g. https://api.example.com/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile site key (public). Used from Phase 1.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
